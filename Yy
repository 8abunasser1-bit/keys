<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>الرئيسية - منصة الاستثمار</title>
    <style>
        body {
            background-color: #0b0e11;
            color: #eaecef;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            padding-bottom: 80px; /* مساحة للشريط السفلي */
        }

        /* الشريط العلوي */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 20px;
        }
        .header-icons {
            display: flex;
            gap: 15px;
            font-size: 1.2em;
            color: #848e9c;
        }
        .search-bar {
            background-color: #181a20;
            border-radius: 20px;
            padding: 8px 15px;
            flex-grow: 1;
            margin: 0 15px;
            display: flex;
            align-items: center;
            color: #848e9c;
            font-size: 0.9em;
        }

        /* قسم إجمالي الأصول */
        .balance-section {
            padding: 10px 20px 20px;
        }
        .balance-title {
            color: #848e9c;
            font-size: 0.85em;
            margin-bottom: 5px;
        }
        .balance-amount {
            font-size: 2.5em;
            font-weight: bold;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .currency-tag {
            font-size: 0.4em;
            font-weight: normal;
        }

        /* أزرار الإيداع والتداول */
        .main-actions {
            display: flex;
            gap: 15px;
            padding: 0 20px 20px;
        }
        .btn {
            flex: 1;
            padding: 12px 0;
            border-radius: 12px;
            font-weight: bold;
            font-size: 1em;
            text-align: center;
            border: none;
            cursor: pointer;
        }
        .btn-deposit {
            background-color: #ffffff;
            color: #0b0e11;
        }
        .btn-trade {
            background-color: #181a20;
            color: #eaecef;
        }

        /* إعلان العقود الآجلة */
        .promo-banner {
            margin: 0 20px 20px;
            background-color: #181a20;
            border-radius: 8px;
            padding: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8em;
        }
        .promo-text { color: #eaecef; }
        .promo-link { color: #2962ff; }

        /* شبكة الأيقونات (القائمة) */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px 10px;
            padding: 0 20px 20px;
            text-align: center;
        }
        .service-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            position: relative;
        }
        .service-icon {
            width: 45px;
            height: 45px;
            background-color: #181a20;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2em;
        }
        .service-name {
            font-size: 0.7em;
            color: #eaecef;
        }
        .badge {
            position: absolute;
            top: -5px;
            right: 0;
            background-color: #2962ff;
            color: white;
            font-size: 0.6em;
            padding: 2px 5px;
            border-radius: 4px;
        }

        /* قسم السوق (الكريبتو) */
        .market-section {
            background-color: #181a20;
            margin: 0 20px;
            border-radius: 15px;
            padding: 20px;
        }
        .market-header {
            color: #848e9c;
            font-size: 0.8em;
            margin-bottom: 15px;
        }
        .market-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .sentiment-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 3px solid #0ecb81;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #0ecb81;
            font-size: 0.8em;
            font-weight: bold;
        }
        .sentiment-text { font-size: 0.5em; font-weight: normal; margin-top: 2px;}
        .coin-price {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .price-change { color: #f6465d; font-weight: bold; }
        .coin-symbol { font-weight: bold; font-size: 1.2em; }

        /* شريط التنقل السفلي */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: #0b0e11;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top: 1px solid #181a20;
            z-index: 100;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #848e9c;
            font-size: 0.7em;
            gap: 5px;
        }
        .nav-item.active {
            color: #eaecef;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- الشريط العلوي -->
    <div class="top-header">
        <div class="header-icons">👤</div>
        <div class="search-bar">🔍 SPCX</div>
        <div class="header-icons">
            <span>🔲</span>
            <span>💬</span>
        </div>
    </div>

    <!-- إجمالي الأصول -->
    <div class="balance-section">
        <div class="balance-title">إجمالي الأصول 👁️</div>
        <div class="balance-amount">
            {% if balances %}
                {{ balances.0.balance|floatformat:0 }} 
            {% else %}
                0
            {% endif %}
            <span class="currency-tag">▼ USDT</span>
        </div>
    </div>

    <!-- الأزرار الرئيسية -->
    <div class="main-actions">
        <button class="btn btn-deposit">إيداع</button>
        <button class="btn btn-trade">تداول</button>
    </div>

    <!-- إعلان -->
    <div class="promo-banner">
        <span class="promo-link">جرب الآن ></span>
        <span class="promo-text">تداول العقود الآجلة لتحقيق أقصى قدر من العائدات</span>
    </div>

    <!-- شبكة الخدمات -->
    <div class="services-grid">
        <div class="service-item">
            <div class="service-icon">🎁</div>
            <div class="service-name">مكافآت التداول</div>
        </div>
        <div class="service-item">
            <div class="service-icon">0</div>
            <div class="service-name">رسوم</div>
        </div>
        <div class="service-item">
            <div class="service-icon">📈</div>
            <div class="service-name">الأسهم الرائجة</div>
        </div>
        <div class="service-item">
            <div class="badge">5% Off</div>
            <div class="service-icon">👥</div>
            <div class="service-name">P2P</div>
        </div>
        
        <div class="service-item">
            <div class="badge">1</div>
            <div class="service-icon">📦</div>
            <div class="service-name">M-Day</div>
        </div>
        <div class="service-item">
            <div class="service-icon">🗓️</div>
            <div class="service-name">مكافآت تسجيل الدخول</div>
        </div>
        <div class="service-item">
            <div class="service-icon">💳</div>
            <div class="service-name">بطاقة المنصة</div>
        </div>
        <div class="service-item">
            <div class="badge">1</div>
            <div class="service-icon">🚀</div>
            <div class="service-name">Launchpad</div>
        </div>
    </div>

    <!-- قسم السوق -->
    <div class="market-section">
        <div class="market-header">الكريبتو 🔥</div>
        <div class="market-row">
            <div class="sentiment-circle">
                70%
                <div class="sentiment-text">معنويات صاعدة</div>
            </div>
            <div class="coin-price">
                <span class="price-change">-0.64%</span>
                <span class="coin-symbol">BTC ₿</span>
            </div>
        </div>
    </div>

    <!-- شريط التنقل السفلي -->
    <div class="bottom-nav">
        <div class="nav-item">
            <span style="font-size: 1.5em;">💼</span>
            المحفظة
        </div>
        <div class="nav-item">
            <span style="font-size: 1.5em;">📄</span>
            العقود الآجلة
        </div>
        <div class="nav-item">
            <span style="font-size: 1.5em;">💱</span>
            تداول
        </div>
        <div class="nav-item">
            <span style="font-size: 1.5em;">📊</span>
            الأسواق
        </div>
        <div class="nav-item active">
            <span style="font-size: 1.5em;">🏠</span>
            الرئيسية
        </div>
    </div>

</body>
</html>
