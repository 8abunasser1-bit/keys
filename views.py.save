# دالة العقود الآجلة (Futures Trade)
# ==========================================
@login_required(login_url='login')
def futures_trade_view(request):
    # جلب رصيد المستثمر لعرضه في واجهة التداول
    user_bal, _ = UserBalance.objects.get_or_create(user=request.user, defaults={'balance': 0})
    
    # جلب صفقات العقود المفتوحة الخاصة بالمستثمر
    open_trades = FuturesTrade.objects.filter(user=request.user, status='open').order_by('-created_at')
    
    context = {
        'balance': user_bal.balance,
        'open_trades': open_trades
    }
    return render(request, 'futures.html', context)
